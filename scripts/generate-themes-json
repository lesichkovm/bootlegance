#!/usr/bin/env python3
"""
Scans the themes/ directory and writes themes.json at the repository root.
Only directories containing theme.css and matching ^[a-z0-9-]+$ are included.

Each manifest entry is {"slug": "...", "name": "..."} where the display name is
extracted from the theme's index.html <title> ("Bootlegance — {Name}"), with a
title-cased slug as fallback.
"""

import json
import os
import re
import sys

# Standard slug pattern allowing lowercase letters, numbers, and hyphens (matches win98, material-3, etc.)
SLUG_PATTERN = re.compile(r'^[a-z0-9-]+$')

# <title>Bootlegance — {Name}</title> — em dash (or hyphen) separates the name
TITLE_PATTERN = re.compile(r'<title>\s*Bootlegance\s+[—–-]\s*(.*?)\s*</title>', re.IGNORECASE | re.DOTALL)


def display_name(theme_dir, slug):
    """Extract the friendly name from the theme's index.html <title>."""
    index_path = os.path.join(theme_dir, "index.html")
    if os.path.isfile(index_path):
        try:
            with open(index_path, "r", encoding="utf-8") as f:
                match = TITLE_PATTERN.search(f.read(8192))
            if match:
                name = re.sub(r'\s*\(Bootstrap\s+\d+\)\s*$', '', match.group(1)).strip()
                if name:
                    return name
        except OSError:
            pass
    # Fallback: title-case the slug
    return slug.replace('-', ' ').title()


def main():
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    themes_dir = os.path.join(repo_root, "themes")

    if not os.path.isdir(themes_dir):
        print(f"Error: themes directory not found at {themes_dir}", file=sys.stderr)
        sys.exit(1)

    themes = []
    for entry in sorted(os.listdir(themes_dir)):
        entry_path = os.path.join(themes_dir, entry)
        if os.path.isdir(entry_path):
            if not SLUG_PATTERN.match(entry):
                print(f"Warning: skipping '{entry}' (does not match slug pattern ^[a-z0-9-]+$)", file=sys.stderr)
                continue
            theme_css = os.path.join(entry_path, "theme.css")
            if os.path.isfile(theme_css):
                themes.append({"slug": entry, "name": display_name(entry_path, entry)})

    themes.sort(key=lambda t: t["slug"])

    output_path = os.path.join(repo_root, "themes.json")
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(themes, f, indent=2, ensure_ascii=False)
        f.write("\n")

    print(f"Successfully generated {output_path} with {len(themes)} themes.")

if __name__ == "__main__":
    main()
